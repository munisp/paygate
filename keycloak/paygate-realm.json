{
  "realm": "paygate",
  "displayName": "PayGate",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "internationalizationEnabled": false,
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "paygate-admin",
        "description": "PayGate platform administrator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "paygate-merchant",
        "description": "PayGate merchant account",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "paygate-consumer",
        "description": "PayGate consumer / end-user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "paygate-partner",
        "description": "PayGate integration partner",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "paygate-operator",
        "description": "PayGate operations staff",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "merchant-portal",
      "name": "PayGate Merchant Portal",
      "description": "PayGate on-premise merchant portal OIDC client",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.lifespan": "300",
        "post.logout.redirect.uris": "*",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "clientScopes": [],
  "identityProviders": [],
  "components": {},

  "otpPolicy": {
    "_comment": "TOTP policy enforced for paygate-admin users. Authenticator apps (Google Authenticator, Authy, etc.) generate 6-digit codes every 30 seconds using SHA1.",
    "type": "totp",
    "algorithm": "HmacSHA1",
    "initialCounter": 0,
    "digits": 6,
    "lookAheadWindow": 1,
    "period": 30
  },

  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {
    "_comment": "SMTP is configured at runtime via KC_SMTP_* env vars in docker-compose.production.yml. This block is intentionally empty — Keycloak merges runtime env vars into the realm SMTP config on startup.",
    "host": "",
    "port": "587",
    "from": "no-reply@paygate.local",
    "fromDisplayName": "PayGate Identity",
    "ssl": "false",
    "starttls": "true",
    "auth": "true",
    "user": "",
    "password": ""
  },
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
