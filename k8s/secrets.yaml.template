# IMPORTANT: This is a template. Replace all <CHANGE_ME> values before applying.
# Apply with: kubectl apply -f secrets.yaml (after filling in values)
# DO NOT commit this file with real secrets to version control.
#
# To create secrets from environment variables:
#   kubectl create secret generic paygate-secrets \
#     --from-literal=PG_DATABASE_URL="$PG_DATABASE_URL" \
#     --from-literal=JWT_SECRET="$JWT_SECRET" \
#     ... etc
#
apiVersion: v1
kind: Secret
metadata:
  name: paygate-secrets
  namespace: paygate
  labels:
    app: paygate-merchant-portal
type: Opaque
stringData:
  PG_DATABASE_URL: "<CHANGE_ME: postgresql://paygate:password@postgres:5432/paygate_prod>"
  JWT_SECRET: "<CHANGE_ME: generate with: openssl rand -hex 64>"
  REDIS_URL: "<CHANGE_ME: redis://:password@redis:6379/0>"
  STRIPE_SECRET_KEY: "<CHANGE_ME: sk_live_...>"
  STRIPE_WEBHOOK_SECRET: "<CHANGE_ME: whsec_...>"
  VITE_STRIPE_PUBLISHABLE_KEY: "<CHANGE_ME: pk_live_...>"
  SMTP_USER: "<CHANGE_ME: noreply@paygate.ng>"
  SMTP_PASS: "<CHANGE_ME: smtp_password>"
  NIBSS_SECRET_KEY: "<CHANGE_ME: nibss_secret_key>"
  NIBSS_WEBHOOK_SECRET: "<CHANGE_ME: nibss_webhook_secret>"
  MOJALOOP_API_KEY: "<CHANGE_ME: mojaloop_api_key>"
  NIP_API_KEY: "<CHANGE_ME: nip_api_key>"
  TERMII_API_KEY: "<CHANGE_ME: termii_api_key>"
  YOUVERIFY_API_KEY: "<CHANGE_ME: youverify_api_key>"
  VTPASS_API_KEY: "<CHANGE_ME: vtpass_api_key>"
  VTPASS_SECRET_KEY: "<CHANGE_ME: vtpass_secret_key>"
  PERMIFY_API_KEY: "<CHANGE_ME: permify_api_key>"
  PERMIFY_URL: "<CHANGE_ME: https://permify.paygate.ng>"
  VAPID_PUBLIC_KEY: "<CHANGE_ME: generate with: npx web-push generate-vapid-keys>"
  VAPID_PRIVATE_KEY: "<CHANGE_ME: generate with: npx web-push generate-vapid-keys>"
  VAPID_SUBJECT: "mailto:admin@paygate.ng"
  BUILT_IN_FORGE_API_KEY: "<CHANGE_ME: forge_api_key>"
  BUILT_IN_FORGE_API_URL: "<CHANGE_ME: https://forge.manus.im>"
  VITE_FRONTEND_FORGE_API_KEY: "<CHANGE_ME: forge_frontend_api_key>"
  VITE_FRONTEND_FORGE_API_URL: "<CHANGE_ME: https://forge.manus.im>"
  INTERNAL_API_KEY: "<CHANGE_ME: generate with: openssl rand -hex 32>"
  MIDDLEWARE_INTERNAL_KEY: "<CHANGE_ME: generate with: openssl rand -hex 32>"
  FRAUD_SCORING_URL: "<CHANGE_ME: https://fraud.paygate.ng>"
  SYNC_RELAY_KEY: "<CHANGE_ME: sync_relay_key>"
  SYNC_RELAY_URL: "<CHANGE_ME: https://relay.paygate.ng>"
  PUSH_SERVICE_KEY: "<CHANGE_ME: push_service_key>"
  PUSH_SERVICE_URL: "<CHANGE_ME: https://push.paygate.ng>"
  TIGERBEETLE_ADDRESS: "<CHANGE_ME: 127.0.0.1:3000>"
  TEMPORAL_HOST_PORT: "<CHANGE_ME: temporal:7233>"
  TEMPORAL_NAMESPACE: "paygate-production"
  KAFKA_BOOTSTRAP_SERVERS: "<CHANGE_ME: kafka:9092>"
  FLUVIO_ENDPOINT: "<CHANGE_ME: fluvio:9003>"
  MIDDLEWARE_BRIDGE_URL: "<CHANGE_ME: https://bridge.paygate.ng>"
  PAYOUT_APPROVER_EMAIL: "payouts@paygate.ng"
  OWNER_NAME: "PayGate Admin"
  OWNER_OPEN_ID: "<CHANGE_ME: owner_open_id>"
  VITE_APP_ID: "<CHANGE_ME: manus_app_id>"
  VITE_APP_TITLE: "PayGate Merchant Portal"
  VITE_KEYCLOAK_URL: "<CHANGE_ME: https://keycloak.paygate.ng>"
  KEYCLOAK_URL: "<CHANGE_ME: https://keycloak.paygate.ng>"
  KEYCLOAK_REALM: "paygate"
  KEYCLOAK_CLIENT_ID: "merchant-portal"
  KEYCLOAK_CLIENT_SECRET: "<CHANGE_ME: keycloak_client_secret>"
  VITE_ANALYTICS_ENDPOINT: "<CHANGE_ME: https://analytics.paygate.ng>"
  VITE_ANALYTICS_WEBSITE_ID: "<CHANGE_ME: analytics_website_id>"
