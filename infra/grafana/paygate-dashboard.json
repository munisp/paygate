{
  "title": "PayGate Platform Overview",
  "uid": "paygate-overview",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["paygate", "production"],
  "panels": [
    {
      "id": 1,
      "title": "API Availability",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "avg(up{job=~\"paygate-.*\"}) * 100",
        "legendFormat": "Availability %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 95 },
            { "color": "green", "value": 99 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 2,
      "title": "Request Rate (req/s)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(paygate_http_request_duration_seconds_count[5m]))",
        "legendFormat": "req/s"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(paygate_http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / sum(rate(paygate_http_request_duration_seconds_count[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(paygate_http_request_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 2000 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(paygate_active_connections)",
        "legendFormat": "Connections"
      }]
    },
    {
      "id": 6,
      "title": "Heap Usage",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "paygate_node_process_resident_memory_bytes / 1024 / 1024",
        "legendFormat": "MB"
      }],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 7,
      "title": "HTTP Request Rate by Route",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (route) (rate(paygate_http_request_duration_seconds_count[5m]))",
        "legendFormat": "{{ route }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "title": "Request Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(paygate_http_request_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(paygate_http_request_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(paygate_http_request_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 9,
      "title": "tRPC Calls by Procedure",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (procedure) (rate(paygate_trpc_calls_total[5m]))",
        "legendFormat": "{{ procedure }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 10,
      "title": "DB Query Latency (P95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(paygate_db_query_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P95 DB latency"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 11,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 6 },
      "targets": [{
        "expr": "sum(rate(paygate_cache_operations_total{result=\"hit\"}[5m])) / sum(rate(paygate_cache_operations_total[5m])) * 100",
        "legendFormat": "Hit rate %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 12,
      "title": "Settlement SLA Breaches",
      "type": "stat",
      "gridPos": { "x": 8, "y": 20, "w": 4, "h": 6 },
      "targets": [{
        "expr": "paygate_settlements_sla_breached_total",
        "legendFormat": "SLA Breaches"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Fraud Alerts (15m)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 20, "w": 4, "h": 6 },
      "targets": [{
        "expr": "increase(paygate_fraud_alerts_total[15m])",
        "legendFormat": "Fraud Alerts"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 10 }
          ]
        }
      }
    }
  ]
}
