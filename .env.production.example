# ═══════════════════════════════════════════════════════════════════
# PayGate Merchant Portal — Production Environment Variables
# Copy this file to .env.production and fill in real values
# ═══════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
VITE_APP_TITLE=PayGate Merchant Portal
MERCHANT_PORTAL_URL=https://portal.paygate.ng
PAYMENT_LINK_BASE_URL=https://pay.paygate.ng

# ── Database ───────────────────────────────────────────────────────
POSTGRES_DB=paygate_prod
POSTGRES_USER=paygate
POSTGRES_PASSWORD=CHANGE_ME_strong_password_2026
PG_DATABASE_URL=postgresql://paygate:CHANGE_ME_strong_password_2026@postgres:5432/paygate_prod

# ── Redis ──────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_2026
REDIS_URL=redis://:CHANGE_ME_redis_password_2026@redis:6379

# ── JWT ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_jwt_secret_minimum_32_characters_long_2026

# ── Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ── SMTP / Email ───────────────────────────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@paygate.ng
SMTP_PASS=CHANGE_ME_smtp_password

# ── NIBSS ──────────────────────────────────────────────────────────
NIBSS_GATEWAY_URL=https://nibss-gateway.paygate.ng
NIBSS_INSTITUTION_CODE=000001
NIBSS_SECRET_KEY=CHANGE_ME_nibss_secret
NIBSS_WEBHOOK_SECRET=CHANGE_ME_nibss_webhook_secret

# ── Mojaloop ───────────────────────────────────────────────────────
MOJALOOP_URL=https://mojaloop.paygate.ng
MOJALOOP_API_KEY=CHANGE_ME_mojaloop_key

# ── NIP Gateway ────────────────────────────────────────────────────
NIP_API_KEY=CHANGE_ME_nip_key

# ── YouVerify KYC ──────────────────────────────────────────────────
YOUVERIFY_API_KEY=CHANGE_ME_youverify_key

# ── Termii SMS ─────────────────────────────────────────────────────
TERMII_API_KEY=CHANGE_ME_termii_key

# ── VTPass (Airtime/Bills) ─────────────────────────────────────────
VTPASS_API_KEY=CHANGE_ME_vtpass_key
VTPASS_SECRET_KEY=CHANGE_ME_vtpass_secret
VTPASS_SANDBOX=false

# ── Keycloak ───────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=paygate
KEYCLOAK_CLIENT_ID=paygate-portal
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_keycloak_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# ── Temporal ───────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=paygate-prod

# ── Qdrant ─────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ── FalkorDB ───────────────────────────────────────────────────────
FALKORDB_URL=redis://falkordb:6379
FALKORDB_PORT=6380

# ── Kafka ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092

# ── MinIO (Lakehouse S3) ───────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
LAKEHOUSE_BUCKET=paygate-lakehouse

# ── Internal Services ──────────────────────────────────────────────
INTERNAL_API_KEY=CHANGE_ME_internal_api_key_min32chars
FRAUD_SCORING_URL=http://fraud-scoring:8000
VECTOR_STORE_URL=http://vector-store:8000
KNOWLEDGE_GRAPH_URL=http://knowledge-graph:8000
ART_REASONING_URL=http://art-reasoning:8000
COCOINDEX_URL=http://cocoindex:8000
LAKEHOUSE_AI_URL=http://lakehouse-ai:8000
AI_INSIGHTS_URL=http://ai-insights:8000
AML_MONITOR_URL=http://aml-monitor:8000
SETTLEMENT_FORECAST_URL=http://settlement-forecast:8000

# ── Observability ──────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_SERVICE_NAME=paygate-merchant-portal
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── Manus OAuth (auto-injected in Manus environment) ───────────────
# VITE_APP_ID=auto_injected
# OAUTH_SERVER_URL=auto_injected
# VITE_OAUTH_PORTAL_URL=auto_injected
# OWNER_OPEN_ID=auto_injected
# OWNER_NAME=auto_injected
